@startuml
title DYS Financial Management System (DYS FMS) - Use Case Diagram
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FCF3CF
  BorderColor #7D6608
}

actor "Business Owner" as owner
actor "Event Manager" as manager
actor "Bookkeeper" as bookkeeper
actor "Employee/Event Staff" as staff

rectangle "DYS Financial Management System" {
  usecase "Login" as login
  usecase "Logout" as logout
  usecase "Restore Session" as restore
  usecase "View Dashboard" as dashboard
  usecase "Record Sales" as recordSales
  usecase "Record Expenses" as recordExpenses
  usecase "Calculate Payroll" as calculatePayroll
  usecase "View Reports" as viewReports
  usecase "View Financial Summary" as viewSummary
  usecase "View Sales Reports" as viewSalesReports
  usecase "View Expense Reports" as viewExpenseReports
  usecase "View Payroll Reports" as viewPayrollReports
  usecase "View Analytics" as viewAnalytics
  usecase "View Own Payroll" as viewOwnPayroll
  usecase "Switch Business Sector" as switchSector
  usecase "Manage User Accounts" as manageUsers
}

owner -- login
owner -- logout
owner -- restore
owner -- dashboard
owner -- recordSales
owner -- recordExpenses
owner -- calculatePayroll
owner -- viewReports
owner -- viewAnalytics
owner -- switchSector
owner -- manageUsers

manager -- login
manager -- logout
manager -- restore
manager -- dashboard
manager -- recordSales
manager -- recordExpenses
manager -- viewReports
manager -- viewOwnPayroll

bookkeeper -- login
bookkeeper -- logout
bookkeeper -- restore
bookkeeper -- dashboard
bookkeeper -- viewReports
bookkeeper -- viewAnalytics
bookkeeper -- viewPayrollReports

staff -- login
staff -- logout
staff -- restore
staff -- dashboard
staff -- viewOwnPayroll

viewReports ..> viewSummary : <<include>>
viewReports ..> viewSalesReports : <<include>>
viewReports ..> viewExpenseReports : <<include>>
viewReports ..> viewPayrollReports : <<include>>
viewReports ..> viewAnalytics : <<extend>>
@enduml
