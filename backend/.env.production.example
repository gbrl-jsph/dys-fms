# DYS FMS — Production env template
# Copy to your cloud provider's Environment Variables / Secrets.
# NEVER commit real secrets. Provider examples: Render Dashboard > Environment, Koyeb > Service > Environment, Fly.io fly secrets set, AlwaysData > Administration.

APP_NAME="DYS Financial Management System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_VIA_php_artisan_key_generate__show
APP_URL=https://<your-production-domain>

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<aiven-service-host>
DB_PORT=<aiven-service-port>
DB_DATABASE=<db_name>
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>
# Required only while RUN_SEEDERS=true on a fresh production database.
OWNER_PASSWORD=<one-time-initial-business-owner-password>
# Aiven requires verified TLS. Upload its downloaded CA as a Render secret file,
# then set this to the file's absolute runtime path. Never disable verification.
MYSQL_ATTR_SSL_CA=<render-secret-file-path-to-aiven-ca>

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Mail — use provider secrets, rotate if previously exposed locally
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp_user>
MAIL_PASSWORD=<smtp_app_password_ROTATE_IF_EXPOSED>
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=<from_address>
MAIL_FROM_NAME="DYS Financial Management System"

SANCTUM_STATEFUL_DOMAINS=<your-flutter-web-host>
SESSION_DOMAIN=<shared-cookie-domain>
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://<your-flutter-web-origin>

# Deployment toggles (set in provider env)
RUN_MIGRATIONS=true
RUN_SEEDERS=false
