APP_NAME="DYS Financial Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dys_fms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# Transport security (Laravel 12 / Symfony SMTP — MAIL_ENCRYPTION is unused;
# MAIL_SCHEME is the transport type, NOT an encryption mode):
#   - MAIL_SCHEME=smtp + MAIL_PORT=587   -> SMTP with STARTTLS (recommended)
#   - MAIL_SCHEME=smtps + MAIL_PORT=465  -> implicit TLS (SSL)
#   - NEVER set MAIL_SCHEME=tls — Symfony rejects it ("The \"tls\" scheme is not supported")
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=noreply@dys-fms.onrender.com
MAIL_FROM_NAME="DYS Financial Management System"
# Log channel for mail failover fallback (when SMTP is unavailable).
MAIL_LOG_CHANNEL=single

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000
SESSION_DRIVER=cookie

CORS_ALLOWED_ORIGINS=*

# Owner account password used by UserSeeder (idempotent updateOrInsert).
# Set this in production; falls back to 'SecurePass123' for local dev only.
OWNER_PASSWORD=
